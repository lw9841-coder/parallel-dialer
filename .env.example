# Copy to .env and fill in. Never commit .env.

# --- Twilio (console.twilio.com) --------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=

# The number your contacts see. Keep ONE consistent local number -- rotating
# numbers is what spam traffic looks like to carriers.
CALLER_ID=+1XXXXXXXXXX

# Your cell. The dialer rings you once at session start; you stay on the line.
AGENT_PHONE=+1XXXXXXXXXX

# Public HTTPS URL of this server, no trailing slash. run.sh fills this in.
#   cloudflared tunnel --url http://localhost:5111
PUBLIC_URL=https://something.trycloudflare.com

# --- Contacts ---------------------------------------------------------------
# CSV to load when the UI path box is blank. Defaults to sample_contacts.csv.
CONTACTS_CSV=

# --- Dialing ----------------------------------------------------------------
LINES_PER_BATCH=3
RING_TIMEOUT=22

# Enable = fast verdict (~3-4s), you hear a bit of the greeting.
# DetectMessageEnd = waits for the beep, better voicemail drops, longer wait.
MACHINE_DETECTION=Enable
AMD_TIMEOUT=15
VOICEMAIL_PAUSE=3

# Publicly reachable mp3/wav of your pre-recorded voicemail. Blank = no drop.
VOICEMAIL_AUDIO_URL=

AUTO_ADVANCE=true
WRAPUP_SECONDS=0
RECORD_CALLS=false

# --- Server -----------------------------------------------------------------
PORT=5111
VALIDATE_TWILIO_SIGNATURES=true
